# Google sign-in + cloud saving (Firebase, free tier). Copy to .env.local and fill in.
# Leave these empty and the app works fine, just saved on this device only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing without a real project: run `npm run emulators`, then use
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_AUTH_DOMAIN=demo-last-minute-planner.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=demo-last-minute-planner
#   VITE_FIREBASE_APP_ID=demo-app
#   VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR=false
